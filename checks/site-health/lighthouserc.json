{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "onlyCategories": ["performance", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.7, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.8, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 0.8, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-results"
    }
  }
}
